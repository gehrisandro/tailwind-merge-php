parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Cannot call method get\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Method TailwindMerge\\Support\\ClassMap\:\:isThemeGetter\(\) has parameter \$classDefinition with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Method TailwindMerge\\Support\\ClassMap\:\:processClassesRecursively\(\) has parameter \$classGroup with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Method TailwindMerge\\Support\\ClassMap\:\:processClassesRecursively\(\) has parameter \$theme with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \#1 \$callback of method TailwindMerge\\Support\\Collection\<\(int\|string\),mixed\>\:\:map\(\) expects callable\(mixed, int\|string\)\: \(array\<string, array\>\|non\-falsy\-string\), Closure\(array\|string\)\: \(array\<string, array\>\|non\-falsy\-string\) given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \#1 \$callback of method TailwindMerge\\Support\\Collection\<\(int\|string\),mixed\>\:\:mapWithKeys\(\) expects callable\(mixed, int\|string\)\: array\<non\-falsy\-string, array\>, Closure\(array, string\)\: non\-empty\-array\<non\-falsy\-string, array\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \#1 \$classDefinition of static method TailwindMerge\\Support\\ClassMap\:\:isThemeGetter\(\) expects array\|\(callable\(\)\: mixed\)\|TailwindMerge\\ValueObjects\\ThemeGetter, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \#1 \$classGroup of static method TailwindMerge\\Support\\ClassMap\:\:processClassesRecursively\(\) expects array, mixed given\.$#'
			identifier: argument.type
			count: 3
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \#2 \$path of static method TailwindMerge\\Support\\ClassMap\:\:getPart\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Parameter \$validator of class TailwindMerge\\ValueObjects\\ClassValidatorObject constructor expects Closure, callable\(\)\: mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/ClassMap.php

		-
			message: '#^Property TailwindMerge\\Support\\Collection\<TKey of \(int\|string\),TValue\>\:\:\$items \(array\<TKey of \(int\|string\), TValue\>\) does not accept array\<TValue\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Support/Collection.php

		-
			message: '#^Cannot access offset \(int\|string\) on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) has parameter \$baseConfig with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) has parameter \$mergeValue with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) should return array\|bool\|float\|int\|string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Parameter \#1 \$baseConfig of static method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/Config.php

		-
			message: '#^Parameter \#3 \$mergeValue of static method TailwindMerge\\Support\\Config\:\:mergePropertyRecursively\(\) expects array\|bool\|float\|int\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: src/Support/Config.php

		-
			message: '#^Method TailwindMerge\\Support\\TailwindClassParser\:\:__construct\(\) has parameter \$configuration with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Support/TailwindClassParser.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$config$#'
			identifier: parameter.notFound
			count: 1
			path: src/Support/TailwindClassParser.php

		-
			message: '#^Parameter \#1 \$config of static method TailwindMerge\\Support\\ClassMap\:\:create\(\) expects array\{cacheSize\: int, prefix\: string\|null, theme\: array\<string, mixed\>, classGroups\: array\<string, mixed\>, conflictingClassGroups\: array\<string, array\<int, string\>\>, conflictingClassGroupModifiers\: array\<string, array\<int, string\>\>\}, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/Support/TailwindClassParser.php

		-
			message: '#^Cannot access offset string on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/TailwindMerge.php

		-
			message: '#^Method TailwindMerge\\TailwindMerge\:\:getConflictingClassGroupIds\(\) should return array\<string\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/TailwindMerge.php
